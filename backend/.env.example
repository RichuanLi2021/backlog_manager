# Copy to backend/.env and fill in. This file stays on your machine; it is never
# sent to the browser and is excluded from git.

# Jira. Create a personal access token in Jira under Profile -> Personal Access Tokens.
JIRA_URL=https://jira.synnex.com
JIRA_PAT=

# Passphrase that unlocks adding and removing people on the Users page.
# Anyone can read the group list; only someone with this can change it.
ADMIN_KEY=change-me

# Optional
# DEFAULT_QUARTER=2026Q3
# Keep the database off any synced folder such as OneDrive or Dropbox.
# DATABASE_URL=sqlite:///C:/backlog_manager/backlog.db
