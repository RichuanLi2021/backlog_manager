# Jira credentials. The backend reads these through the jira-rel-review skill,
# which also falls back to ~/.cursor/skills-cursor/.env if this file is absent.
# The PAT stays server-side and is never sent to the browser.
JIRA_URL=https://jira.synnex.com
JIRA_PAT=

# Optional backend overrides
# DEFAULT_QUARTER=2026Q3
# DATABASE_URL=sqlite:///backend/backlog.db
# JIRA_REL_REVIEW_DIR=.cursor/skills/jira-rel-review

# backend/.env holds settings the browser never sees. It needs one entry:
#   ADMIN_KEY=<passphrase that unlocks group management on the Users page>
# Without it the Users page stays read-only for everyone.
